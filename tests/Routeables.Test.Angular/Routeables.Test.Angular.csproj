<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server of the Angular sample (samples/Angular/XAnimals.AngularServer) seen as the Angular app sees it: a session per connection,
    the messages it receives, the calls it makes. No browser: the pages, the commands, the dialogs and the modal are checked where the
    app gets them. The client side is tested in clients/typescript (npm test).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Angular\XAnimals.AngularServer\XAnimals.AngularServer.csproj" />
    <ProjectReference Include="..\..\src\Routeables.SignalR\Routeables.SignalR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Screenshots of the Avalonia host: Avalonia.Headless with Skia draws the real controls of Routeables.Avalonia into a bitmap, and each
    picture is compared with the one kept in Snapshots (see Shared/Snapshot.cs). It is a project of its own because drawing changes the
    headless platform of the whole process (UseHeadlessDrawing = false), which the tests of Routeables.Test.Avalonia do without.

    The images are those of Skia with the Inter font on Linux: make them with CI (the job uploads Snapshots/_actual), not on your own machine.
    Run: dotnet test --project tests/Routeables.Test.Avalonia.Visual/Routeables.Test.Avalonia.Visual.csproj -c Release
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.0.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Snapshot.cs" Link="Shared\Snapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Routeables.Avalonia\Routeables.Avalonia.csproj" />
    <ProjectReference Include="..\..\reshapes\Reshapes.Avalonia.Fluent\Reshapes.Avalonia.Fluent.csproj" />
  </ItemGroup>

</Project>

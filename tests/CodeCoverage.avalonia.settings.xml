<?xml version="1.0" encoding="utf-8"?>
<!-- The same as CodeCoverage.settings.xml, except that the code the compiler writes is not left out. The headless tests of Avalonia drive dialogs, pages and
     regions, and their report shows 0% for code they run: DialogPresenter has 111 lines at 0% while the dialog tests open its windows, and
     DefaultMessageBoxService, 380 lines of async methods, has 6 lines in the report. An async method or a lambda is a class the compiler writes,
     marked CompilerGenerated, and excluding that attribute may leave its body out of the report. If this file gives the figures that the tests
     deserve, the first file can drop the exclusion too (the floor of the job "Code coverage" would have to follow the new figures).
     What the coverage option of `dotnet test` measures (Microsoft.Testing.Extensions.CodeCoverage): the libraries of Routeables, not the tests, the
     packages they use. Passed with the coverage-settings option. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Routeables\.[^\\/]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*[\\/]Routeables\.Test[^\\/]*\.dll$</ModulePath>
        <ModulePath>.*[\\/]Routeables\.Benchmarks[^\\/]*\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <CollectFromChildProcesses>True</CollectFromChildProcesses>
    <UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>
  </CodeCoverage>
</Configuration>

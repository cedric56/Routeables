<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Device tests of the MAUI host: a MAUI application that runs the tests inside itself, on the platform, with the real handlers and the
    real native controls (the way the dotnet/maui "DeviceTests" do, https://github.com/dotnet/maui/wiki/DeviceTests). The runner is
    DeviceRunners (the runner of dotnet/maui is not a public package): xunit v3, a visual runner on the screen, and `dotnet test` that
    starts the application on a device, collects the results and stops it (see below).

    Run (a device or emulator must be there: Android emulator, iOS simulator; Mac Catalyst and Windows run on the machine).
    global.json turns on the Microsoft.Testing.Platform runner for the repository, which `dotnet test` of a device project does not use:
    the VSTest target of DeviceRunners.Testing.Targets is called directly.
      dotnet msbuild Tests/Routeables.Test.Maui/Routeables.Test.Maui.csproj -restore -t:VSTest -p:DeviceTfm=net10.0-android
      dotnet msbuild Tests/Routeables.Test.Maui/Routeables.Test.Maui.csproj -restore -t:VSTest -p:DeviceTfm=net10.0-ios
      dotnet msbuild Tests/Routeables.Test.Maui/Routeables.Test.Maui.csproj -restore -t:VSTest -p:DeviceTfm=net10.0-maccatalyst
      dotnet msbuild Tests/Routeables.Test.Maui/Routeables.Test.Maui.csproj -restore -t:VSTest -p:DeviceTfm=net10.0-windows10.0.19041.0
    DeviceTfm (not TargetFramework) names the platform: a TargetFramework given on the command line also goes to the libraries this project
    references, which are built for net10.0 and would be restored for the wrong framework.
    Or deploy it from the IDE: the visual runner lists the tests and runs them.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- One platform, named by the command line (see above): the project is then built for it alone, and the libraries keep their own frameworks. -->
    <TargetFrameworks Condition="'$(DeviceTfm)' != ''"></TargetFrameworks>
    <TargetFramework Condition="'$(DeviceTfm)' != ''">$(DeviceTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Routeables.Test.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Routeables.Test.Maui</ApplicationTitle>
    <ApplicationId>com.routeables.test.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- A test class is found by reflection: the trimmer of a Release build must not remove it. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4A22C8" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4A22C8" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <!-- xunit v3 for a library that a MAUI application hosts: the assertions and the attributes, never "xunit.v3" (it makes the project an executable of its own).
         The versions of these packages could not be checked where this project was written: pin them to the ones restored. -->
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    <PackageReference Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.*" />
    <PackageReference Include="DeviceRunners.VisualRunners.Xunit3" Version="0.1.0-preview.*" />
    <PackageReference Include="DeviceRunners.UITesting.Maui" Version="0.1.0-preview.*" />
    <PackageReference Include="DeviceRunners.UITesting.Xunit3" Version="0.1.0-preview.*" />
    <!-- `dotnet test -f net10.0-android` (and the other platforms) starts the application, reads its results and stops it. -->
    <PackageReference Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RouterContract.cs" Link="Shared\RouterContract.cs" />
    <Compile Include="..\Shared\Snapshot.cs" Link="Shared\Snapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Routeables.Maui\Routeables.Maui.csproj" />
    <ProjectReference Include="..\..\reshapes\Reshapes.Maui.Community\Reshapes.Maui.Community.csproj" />
  </ItemGroup>

</Project>

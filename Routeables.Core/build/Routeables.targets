<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- The flavours are opt-in sources, next to this file whatever the target framework of the project (net10.0, net11.0, net10.0-android...):
       RouteablesFeatures adds them to the project. The packages they use (CommunityToolkit.Mvvm;
       ReactiveUI and ReactiveUI.SourceGenerators) are the application's own PackageReference, with the version it chooses. -->
  <ItemGroup Condition="$(RouteablesFeatures.Contains(';CommunityToolkit;'))">
    <Compile Include="$(MSBuildThisFileDirectory)Community\**\*.cs">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition="$(RouteablesFeatures.Contains(';ReactiveUI;'))">
    <Compile Include="$(MSBuildThisFileDirectory)Reactive\**\*.cs">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>

</Project>

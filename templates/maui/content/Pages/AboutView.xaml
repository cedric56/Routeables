<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:local="clr-namespace:RouteablesApp"
    x:Class="RouteablesApp.AboutView"
    x:DataType="local:AboutViewModel">
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="{Binding Text}" FontSize="18" />
        <Button Text="Hello" routeables:RouteableLink.Route="/hello/again" />
    </VerticalStackLayout>
</routeables:RouteableFor>

@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* The scoped styles of the application and of Routeables.Blazor (layout, menu, dialogs) are in this bundle: without it the dialogs are not overlays. *@
    <link rel="stylesheet" href="@Assets["RouteablesApp.styles.css"]" />
    <link rel="stylesheet" href="_content/Routeables.Blazor/theme.css" />
    <HeadOutlet @rendermode="_mode" />
</head>

<body>
    <Routes @rendermode="_mode" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
@code {
    private static readonly IComponentRenderMode _mode = new InteractiveServerRenderMode(prerender: false);
}

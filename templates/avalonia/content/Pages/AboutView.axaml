<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RouteablesApp"
             x:Class="RouteablesApp.AboutView"
             x:DataType="local:AboutViewModel">
    <TextBlock Margin="24" Text="{Binding Text}" VerticalAlignment="Center" />
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Shipped inside the Routeables package (Routeables.Core/Routeables.nuspec), not as a package of its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
    <InternalsVisibleTo Include="Routeables.Wpf" />
    <InternalsVisibleTo Include="Routeables.Avalonia" />
    <InternalsVisibleTo Include="Routeables.Uno" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Abstraction\Routeables.Abstraction.csproj" />
    <ProjectReference Include="..\Routeables.Routing\Routeables.Routing.csproj" />
  </ItemGroup>
</Project>

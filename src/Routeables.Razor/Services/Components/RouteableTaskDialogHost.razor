@namespace Routeables.Razor.Services
@using Microsoft.AspNetCore.Components.Web
@using Routeables.Abstraction
@using Routeables.Razor
@using Routeables.Services
@implements IDisposable
@inject RouteableTaskDialogQueue Queue

@if (Queue.Current is { } request)
{
    var dialog = request.Parameters;
    <div class="rt-backdrop" @onclick="Queue.Dismiss">
        <div class="rt-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@(HasText(dialog.Title) ? "rt-task-title" : null)"
             tabindex="-1"
             @ref="dialogElement"
             @onclick:stopPropagation="true"
             @onkeydown="OnKeyDown">
            @if (HasText(dialog.Title))
            {
                <h2 id="rt-task-title" class="rt-title">@dialog.Title</h2>
            }

            <div class="rt-body">
                <div class="rt-header-row">
                    @if (dialog.IconSource is RouteableFor icon)
                    {
                        <div class="rt-header-icon">@icon.Render()</div>
                    }
                    @if (HasText(dialog.Header))
                    {
                        <div class="rt-header">@dialog.Header</div>
                    }
                </div>

                @if (HasText(dialog.SubHeader))
                {
                    <div class="rt-subheader">@dialog.SubHeader</div>
                }

                @if (dialog.Content is RouteableFor content)
                {
                    @content.Render()
                }
                else
                {
                    @dialog.Content
                }

                @if (dialog.ShowProgressBar)
                {
                    <div class="rt-progress" role="progressbar" aria-busy="true"><div class="rt-progress-bar"></div></div>
                }

                @if (dialog.ShowsFooter)
                {
                    @if (dialog.IsFooterCollapsible)
                    {
                        <button type="button" class="rt-footer-toggle" aria-expanded="@footerExpanded.ToString().ToLowerInvariant()"
                                @onclick="() => footerExpanded = !footerExpanded">
                            @(footerExpanded ? "Less details" : "More details")
                        </button>
                    }
                    @if (footerExpanded && dialog.Footer is RouteableFor footer)
                    {
                        <div class="rt-footer">@footer.Render()</div>
                    }
                }
            </div>

            <div class="rt-actions">
                @foreach (var button in request.Session.Buttons)
                {
                    var current = button;
                    <button type="button" class="rt-button" @onclick="() => Press(current)">@current.Text</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference dialogElement;
    private TaskDialogRequest? shown;
    private bool footerExpanded;
    private TaskDialogRequest? footerOwner;

    private static bool HasText(string? text) => !string.IsNullOrWhiteSpace(text);

    protected override void OnInitialized()
    {
        Queue.Changed += OnChanged;
        ResetFooter();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A newly displayed dialog: announce it, then move the focus inside so the keyboard acts on it.
        if (Queue.Current is { } request && !ReferenceEquals(request, shown))
        {
            shown = request;
            request.Session.Opening();
            await dialogElement.FocusAsync();
            request.Session.Opened();
        }
    }

    private void OnChanged()
    {
        ResetFooter();
        _ = InvokeAsync(StateHasChanged);
    }

    // The footer starts expanded when it is always visible or when the dialog asks for it.
    private void ResetFooter()
    {
        if (Queue.Current is { } request && !ReferenceEquals(request, footerOwner))
        {
            footerOwner = request;
            footerExpanded = request.Parameters.FooterStartsExpanded;
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Queue.Dismiss();
    }

    private static void Press(RouteableDialogButton button) => button.Press();

    public void Dispose() => Queue.Changed -= OnChanged;
}

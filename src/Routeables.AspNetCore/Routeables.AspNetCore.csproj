<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Routeables.AspNetCore</PackageId>
    <Authors>Cédric Boutin</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Routeables for ASP.NET Core Razor Pages and MVC views: view-model-first routing, dialogs and notifications on the server. The application provides one service scope per visitor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\transitions.css" LogicalName="Routeables.AspNetCore.transitions.css" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Routeables.Core only, as the other hosts: it is the "Routeables" package, which holds Routeables.Segments and depends on
         Routeables.Abstraction. A reference to Routeables.Segments here became a dependency on a package that does not exist. -->
    <ProjectReference Include="..\Routeables.Core\Routeables.Core.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\transitions.css" LogicalName="Routeables.AspNetCore.transitions.css" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Core\Routeables.Core.csproj" />
    <ProjectReference Include="..\Routeables.Abstraction\Routeables.Abstraction.csproj" />
    <ProjectReference Include="..\Routeables.Segments\Routeables.Segments.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
  </ItemGroup>
</Project>
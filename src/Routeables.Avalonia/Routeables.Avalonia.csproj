<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Routeables.Native has the system notifications of Android and iOS: an application head gets them only from a build of this library for its own
         platform, so the library is built for each (like Routeables.Uno). A runner only has the SDK packs of its own OS; CiBuild keeps net10.0. -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(CiBuild)' == 'true'">net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Routeables.Avalonia</PackageId>
    <Authors>Cedric</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Routeables for Avalonia: view-model-first routing, routed views, regions, dialogs and notifications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Core\Routeables.Core.csproj" PrivateAssets="none" />
    <!-- The system notifications (Android, iOS) and the dialogs of the platform. -->
    <ProjectReference Include="..\Routeables.Native\Routeables.Native.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>

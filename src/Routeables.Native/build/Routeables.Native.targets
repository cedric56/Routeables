<Project>
  <!-- Routeables.Native looks after its own files: a WebAssembly head (a net10.0-browser application, Avalonia or Uno, which gets no _content files from a Razor project) gets the service
       worker of the browser notifications in its wwwroot, because a service worker must be served from the root of the site. In the package this file is in build/ next to the worker;
       in the repository it is read from the wwwroot of Routeables.Blazor. Set RouteablesCopyNotificationWorker to false to serve the worker some other way. The module notifications.js needs no copy:
       it is embedded in the assembly. -->
  <PropertyGroup>
    <RouteablesNotificationWorker Condition="'$(RouteablesNotificationWorker)' == '' And Exists('$(MSBuildThisFileDirectory)routeables-notifications-worker.js')">$(MSBuildThisFileDirectory)routeables-notifications-worker.js</RouteablesNotificationWorker>
    <RouteablesNotificationWorker Condition="'$(RouteablesNotificationWorker)' == ''">$(MSBuildThisFileDirectory)..\..\Routeables.Blazor\wwwroot\routeables-notifications-worker.js</RouteablesNotificationWorker>
  </PropertyGroup>

  <Target Name="RouteablesCopyNotificationWorker" BeforeTargets="BeforeBuild" Condition="'$(TargetPlatformIdentifier)' == 'browser' And '$(RouteablesCopyNotificationWorker)' != 'false'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
    <Copy SourceFiles="$(RouteablesNotificationWorker)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\" SkipUnchangedFiles="true" />
  </Target>
</Project>

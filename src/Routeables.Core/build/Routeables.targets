<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- The flavours are opt-in sources, next to this file whatever the target framework of the project (net10.0, net11.0, net10.0-android...):
       RouteablesFeatures adds them to the project, with the packages they use (CommunityToolkit.Mvvm; ReactiveUI and
       ReactiveUI.SourceGenerators). A package the application already references is left alone: its version wins.
       To choose another version, reference the package, or set the properties below. With central package management
       (ManagePackageVersionsCentrally) a PackageReference that carries a Version is an error (NU1008): nothing is added then,
       and the application declares the packages in its Directory.Packages.props. -->
  <!-- The source generator reads RouteablesAutoRegister: in an executable it registers the generated routes with the host, so that the
       application does not call AddGeneratedRoutes(). Set it to false to keep calling it yourself. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RouteablesAutoRegister" />
  </ItemGroup>
  <!-- An application of a mobile platform (net10.0-android, net10.0-ios ...) is compiled as a library: the generator, which goes by
       the kind of the compiled assembly, would write no registration there, and no page would be found ("No view is registered
       under the key ..."). An application is known by its OutputType: it registers its routes on every platform. -->
  <PropertyGroup Condition="'$(RouteablesAutoRegister)' == '' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
    <RouteablesAutoRegister>true</RouteablesAutoRegister>
  </PropertyGroup>

  <!-- On Android OutputType is Library when the compiler runs and AndroidApplication is true. The file of the compiler that carries the
       property is written by GenerateMSBuildEditorConfigFileCore, and the dependencies of GenerateMSBuildEditorConfigFile run before a target
       that is only its BeforeTargets: this one comes before the Core target. The same decision, taken when the compiler is about to run: a project of a mobile platform can change its OutputType after the
       properties above were read, and the Android SDK tells an application by AndroidApplication. Without this the generator wrote no
       registration for the MAUI application of Android ("No view is registered under the key ..."). -->
  <Target Name="RouteablesAutoRegisterOfApplication" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFileCore;CoreCompile"
          Condition="'$(RouteablesAutoRegister)' == '' And ('$(AndroidApplication)' == 'true' Or '$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
    <PropertyGroup>
      <RouteablesAutoRegister>true</RouteablesAutoRegister>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <RouteablesCommunityToolkitMvvmVersion Condition="'$(RouteablesCommunityToolkitMvvmVersion)' == ''">8.4.2</RouteablesCommunityToolkitMvvmVersion>
    <RouteablesReactiveUIVersion Condition="'$(RouteablesReactiveUIVersion)' == ''">23.2.28</RouteablesReactiveUIVersion>
    <RouteablesReactiveUISourceGeneratorsVersion Condition="'$(RouteablesReactiveUISourceGeneratorsVersion)' == ''">3.2.0</RouteablesReactiveUISourceGeneratorsVersion>
  </PropertyGroup>

  <ItemGroup Condition="$(RouteablesFeatures.Contains(';CommunityToolkit;'))">
    <Compile Include="$(MSBuildThisFileDirectory)Community\**\*.cs">
      <Visible>false</Visible>
    </Compile>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(RouteablesCommunityToolkitMvvmVersion)"
                      Condition="'$(ManagePackageVersionsCentrally)' != 'true' And '@(PackageReference->WithMetadataValue('Identity', 'CommunityToolkit.Mvvm'))' == ''" />
  </ItemGroup>

  <ItemGroup Condition="$(RouteablesFeatures.Contains(';ReactiveUI;'))">
    <Compile Include="$(MSBuildThisFileDirectory)Reactive\**\*.cs">
      <Visible>false</Visible>
    </Compile>
    <PackageReference Include="ReactiveUI" Version="$(RouteablesReactiveUIVersion)"
                      Condition="'$(ManagePackageVersionsCentrally)' != 'true' And '@(PackageReference->WithMetadataValue('Identity', 'ReactiveUI'))' == ''" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="$(RouteablesReactiveUISourceGeneratorsVersion)" PrivateAssets="all"
                      Condition="'$(ManagePackageVersionsCentrally)' != 'true' And '@(PackageReference->WithMetadataValue('Identity', 'ReactiveUI.SourceGenerators'))' == ''" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Routeables.Blazor</PackageId>
    <Authors>Cédric Boutin</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Routeables for Blazor: view-model-first routing, routed components, regions, dialogs, notifications and the default layout.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
    <InternalsVisibleTo Include="Routeables.Routing" />
    <InternalsVisibleTo Include="Reshapes.Blazor.MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
  </ItemGroup>

  <!-- The browser notification center lives in Routeables.Native (a plain SDK project, so that Avalonia Browser can use it). Its two
       script files are kept here, in wwwroot, and served under the _content path of this package: static web assets need the files
       in the wwwroot of the project that serves them (a linked file is not found by a project that references this one, such as
       MAUI Blazor Hybrid). Routeables.Native embeds and packs them from here. -->

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Core\Routeables.Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Routeables.Native\Routeables.Native.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>

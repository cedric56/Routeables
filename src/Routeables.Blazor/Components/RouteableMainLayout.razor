@using Microsoft.AspNetCore.Components.Web
@using Routeables.Blazor
@inherits RouteableMainLayoutBase
@if (ChildContent != null)
{
    @ChildContent
}
else
{
    

    @* An application without a menu has no drawer and no button to open it. *@
    var hasMenu = MainViewModel.Entries.Count > 0;
    <div class="rt-layout @(hasMenu ? "" : "rt-no-menu")" data-wui-theme="@ThemeName">
            
        
        <header class="rt-appbar">
            @if (hasMenu)
            {
                <button type="button" class="rt-menu-button" aria-label="Toggle menu" aria-expanded="@_drawerOpen.ToString().ToLowerInvariant()" @onclick="DrawerToggle">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" /></svg>
                </button>
            }
            <span class="rt-title">@Title</span>
            <button type="button" class="rt-menu-button rt-theme-button" aria-label="Switch between the light and the dark theme" title="Switch between the light and the dark theme" @onclick="ToggleTheme">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3a9 9 0 1 0 0 18V3z" /><circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            </button>
        </header>

        @if (hasMenu)
        {
            <RouteableMenu Closed="!_drawerOpen" />
        }

        <main class="rt-content">
            <RouteableDialogHost />
            <RouteableContentDialogHost />
            <RouteableTaskDialogHost />
            <RouteableModalHost />
            <RouteableNotificationHost />
            <RouteableRegion/>
        </main>
    </div>
}
@code
{
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A package of its own: the contracts, for the libraries that only declare view models, routes or modules. The Routeables package depends on exactly this version, because the assemblies of the repository see each other's internals (InternalsVisibleTo). -->
    <PackageId>Routeables.Abstraction</PackageId>
    <Authors>Cédric Boutin</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>The contracts of Routeables: IRouter, IRouteable, RouteableArgs, the attributes and the lock and error contracts. A view model depends on these types instead of an API of Blazor, ASP.NET Core, .NET MAUI, Avalonia, Uno, WinUI 3 or WPF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Routing" />
    <InternalsVisibleTo Include="Routeables.Segments" />
    <InternalsVisibleTo Include="Routeables.Regions" />
    <InternalsVisibleTo Include="Routeables.Test" />
    <InternalsVisibleTo Include="Routeables.Core" />
    <InternalsVisibleTo Include="Routeables.Blazor" />
    <InternalsVisibleTo Include="Routeables.AspNetCore" />
    <InternalsVisibleTo Include="Routeables.Maui" />
    <InternalsVisibleTo Include="Routeables.Avalonia" />
    <InternalsVisibleTo Include="Routeables.Uno" />
    <InternalsVisibleTo Include="Routeables.WinUI3" />
    <InternalsVisibleTo Include="Routeables.Wpf" />
    <InternalsVisibleTo Include="Routeables.Benchmarks" />
    <!-- Lets NSubstitute/Castle build proxies of the internal interfaces (e.g. ILockCoordinatorFactory) in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
  </ItemGroup>
</Project>
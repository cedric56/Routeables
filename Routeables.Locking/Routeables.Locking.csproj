<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Routeables.Locking</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Description>Page locking for Routeables: pages that can block leaving, and the broker that locks the main menu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Abstraction\Routeables.Abstraction.csproj" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    x:Class="RouteablesApp.Views.HelloView">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="{Binding Greeting}" FontSize="28" />
        <Label Text="The name comes from the route /hello/{name}." />
        <Button Text="Back" Clicked="OnBack" />
    </VerticalStackLayout>
</routeables:RouteableFor>

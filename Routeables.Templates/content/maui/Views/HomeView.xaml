<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    x:Class="RouteablesApp.Views.HomeView">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="Home" FontSize="28" />
        <Label Text="This page is shown by HomeViewModel. Its route, /home, is declared on the view model." />
        <Button Text="Say hello" Clicked="OnSayHello" />
    </VerticalStackLayout>
</routeables:RouteableFor>

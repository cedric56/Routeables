<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RouteablesApp.Views.HomeView">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Home" FontSize="28" />
        <TextBlock Text="This page is shown by HomeViewModel. Its route, /home, is declared on the view model." TextWrapping="Wrap" />
        <Button Content="Say hello" Click="OnSayHello" />
    </StackPanel>
</UserControl>

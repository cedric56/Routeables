<Project Sdk="Uno.Sdk">

  <!-- The controls the animal pages of the Uno sample are made of (the list, the detail). They draw with the resources of the application (PlainCardBrush, the AnimalImage converter), found when they are shown. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <!-- As the head: the CI builds the desktop target only. -->
    <TargetFrameworks Condition="'$(CiBuild)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UnoFeatures></UnoFeatures>
    <UnoVersion>6.7.135</UnoVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Routeables.Uno\Routeables.Uno.csproj" />
    <ProjectReference Include="..\..\Bases\XAnimals.Common\XAnimals.Common.csproj" />
    <ProjectReference Include="..\..\Bases\XAnimals.ViewModels\XAnimals.ViewModels.csproj" />
  </ItemGroup>

</Project>

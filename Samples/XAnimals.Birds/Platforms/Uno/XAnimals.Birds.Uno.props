<Project>

  <!-- Imported by the Uno head: the views of the Birds module live in the module (Platforms/Uno), the head only compiles them. -->
  <ItemGroup>
    <!-- The pages of the Birds module for the Uno head: compiled with its views, so they find AnimalList. -->
    <Page Include="$(MSBuildThisFileDirectory)*.xaml" Link="Views\Animals\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)*.xaml.cs" Link="Views\Animals\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

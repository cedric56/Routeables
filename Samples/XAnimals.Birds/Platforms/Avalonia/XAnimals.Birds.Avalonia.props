<Project>

  <!-- Imported by the Avalonia head: the views of the Birds module live in the module (Platforms/Avalonia), the head only compiles them. -->
  <ItemGroup>
    <!-- The pages of the Birds module for the Avalonia head: compiled with its views, so they find AnimalList. -->
    <AvaloniaXaml Include="$(MSBuildThisFileDirectory)*.axaml" Link="Views\Animals\%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)*.axaml.cs" Link="Views\Animals\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

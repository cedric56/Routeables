<Project Sdk="Microsoft.NET.Sdk">

  <!-- A module of the samples: a class library with a page (its view model) and one extension method the application calls.
       The views of the page are in Platforms/<head> (Razor, MAUI, Avalonia, Uno); each head imports the props
       of its folder and compiles them with its own controls (AnimalList, AnimalDetail). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Platforms/<head>: the views of each head. The module does not compile them; each head imports its XAnimals.Birds.<head>.props.
       This layout is for the demonstration: a real module has a project per head (XAnimals.Birds.<head>) that the head references. -->
  <ItemGroup>
    <Compile Remove="Platforms\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Routeables.Core\Routeables.Core.csproj" />
    <!--<ProjectReference Include="..\..\Routeables.Razor\Routeables.Razor.csproj" />-->
    <ProjectReference Include="..\..\Routeables.Routing\Routeables.Routing.csproj" />
    <ProjectReference Include="..\XAnimals.Common\XAnimals.Common.csproj" />
  </ItemGroup>

</Project>

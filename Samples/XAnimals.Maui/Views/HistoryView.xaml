<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.HistoryView"
    x:DataType="vm:HistoryViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <!-- Three rows: what comes before the frame, the frame (it takes the room that is left), what comes after. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout>
            <!-- A history entry is an arch: filled where the cursor is, dimmed ahead of it (reached with Forward). -->
            <FlexLayout Wrap="Wrap" JustifyContent="Start" Margin="0,10,0,0" BindableLayout.ItemsSource="{Binding Entries}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItem">
                        <HorizontalStackLayout Margin="0,0,0,8">
                            <Label Text="→" FontSize="12" Margin="4,0" VerticalOptions="Center" IsVisible="{Binding HasPrevious}"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                            <Border StrokeThickness="2" Stroke="Transparent" Padding="8,6,8,5" MinimumWidthRequest="52"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Lichen}, Dark={StaticResource Moss}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22,22,8,8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Tertiary}" />
                                        <Setter Property="TranslationY" Value="-2" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAhead}" Value="True">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{StaticResource Gray400}" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Label Text="{Binding Badge}" FontSize="11" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-6,-7,0" />
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                        <Label Text="{Binding Glyph}" FontSize="18" HorizontalOptions="Center" />
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Caption}" FontSize="9" Opacity="0.8" HorizontalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Number, StringFormat='#{0}'}" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>

            <Border x:Name="FrameHost" Stroke="{StaticResource Primary}" StrokeThickness="2" Padding="0" Margin="0,4,0,0"
                    Grid.Row="1" MinimumHeightRequest="220">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <!-- The zone of the "history" region: nothing assigns the view, the control shows what the router of the region displays.
                     It takes all the room the frame has. -->
                <routeables:RouteableRegion x:Name="HistoryFrame" Region="history" TransitionDuration="0:0:0.22"
                             HorizontalOptions="Fill" VerticalOptions="Fill" InputTransparent="True" />
            </Border>

        <VerticalStackLayout Grid.Row="2">
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Margin="0,0,8,8" Text="＋ Push" Command="{Binding PushCommand}" />
                <Button Margin="0,0,8,8" Text="◀ Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
                <Button Margin="0,0,8,8" Text="Forward ▶" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" />
                <Button Margin="0,0,8,8" Text="↩ Pop" Command="{Binding PopCommand}" IsEnabled="{Binding CanGoBack}" />
            </FlexLayout>

            <Label Text="CanLeaveAsync" FontAttributes="Bold" Margin="0,14,0,0" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <HorizontalStackLayout Spacing="4">
                <CheckBox IsChecked="{Binding BlockLeaving}" VerticalOptions="Center" />
                <Label Text="{Binding GuardText}" FontSize="13" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="6" Margin="0,10,0,0">
                <Label Text="🚫" IsVisible="{Binding IsRefused}" />
                <Label Text="{Binding Status}" LineBreakMode="WordWrap">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsRefused}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource SaffronText}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</routeables:RouteableFor>

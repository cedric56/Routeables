<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.LockView"
    x:DataType="vm:LockViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,40" Spacing="6" MaximumWidthRequest="640">
            <Label Text="Lock the menu" FontFamily="LoraDisplay" FontSize="28" />
            <Label Text="The page publishes a lock message; the menu entries are disabled until it publishes the unlock one."
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />

            <Label Text="Menu" FontAttributes="Bold" Margin="0,14,0,0" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Margin="0,0,8,8" Text="Lock" Command="{Binding LockCommand}" IsEnabled="{Binding CanLock}" />
                <Button Margin="0,0,8,8" Text="Unlock" Command="{Binding UnlockCommand}" IsEnabled="{Binding CanUnlock}" />
                <Button Margin="0,0,8,8" Text="Lock for 5 seconds" Command="{Binding LockForCommand}" IsEnabled="{Binding CanLock}" />
            </FlexLayout>

            <Label Text="{Binding Status}" />
        </VerticalStackLayout>
    </ScrollView>
</routeables:RouteableFor>

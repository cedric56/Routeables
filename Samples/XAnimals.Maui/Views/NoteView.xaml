<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableModalFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui.Services;assembly=Routeables.Maui.Services"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.NoteView"
    x:TypeArguments="vm:NoteViewModel,x:String"
    x:DataType="vm:NoteViewModel">

    <Entry Text="{Binding Note, Mode=TwoWay}" Placeholder="Write a note" MinimumWidthRequest="260" />
</routeables:RouteableModalFor>

<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.ModulesView"
    x:DataType="vm:ModulesViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,40" Spacing="6" MaximumWidthRequest="640">
            <Label Text="Modules" FontFamily="LoraDisplay" FontSize="28" />
            <Label Text="A module is an extension method that the application calls in services. It registers its own services and adds its pages to the menu."
                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />

            <Label Text="Loaded" FontAttributes="Bold" Margin="0,14,0,0" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}" IsVisible="{Binding HasModules}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleItem">
                        <VerticalStackLayout Margin="0,0,0,12" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Description}" />
                            <Button Margin="0,6,0,0" Text="{Binding OpenText}" Command="{Binding OpenCommand}" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="No module is loaded. The host adds one with services.AddBirdsModule()." IsVisible="{Binding HasNoModules}" />
        </VerticalStackLayout>
    </ScrollView>
</routeables:RouteableFor>

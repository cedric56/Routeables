<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.MembersView"
    x:DataType="vm:MembersViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <VerticalStackLayout Padding="20,32,20,40" Spacing="12" MaximumWidthRequest="640">
        <Label Text="{Binding Welcome}" />
        <Button Text="Sign out" Command="{Binding SignOutCommand}" HorizontalOptions="Start" />
    </VerticalStackLayout>
</routeables:RouteableFor>

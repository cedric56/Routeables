<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.DialogsView"
    x:DataType="vm:DialogsViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,32,20,40" Spacing="6" MaximumWidthRequest="640">
            <Label Text="Messages" FontAttributes="Bold" Margin="0,14,0,0" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Margin="0,0,8,8" Text="Ok" Command="{Binding OkCommand}" />
                <Button Margin="0,0,8,8" Text="Error" Command="{Binding ErrorCommand}" />
                <Button Margin="0,0,8,8" Text="Yes / No" Command="{Binding YesNoCommand}" />
                <Button Margin="0,0,8,8" Text="Ok / Cancel" Command="{Binding OkCancelCommand}" />
                <Button Margin="0,0,8,8" Text="Ok / Abort" Command="{Binding OkAbortCommand}" />
                <Button Margin="0,0,8,8" Text="Yes / No / Cancel" Command="{Binding YesNoCancelCommand}" />
                <Button Margin="0,0,8,8" Text="Yes / No / Abort" Command="{Binding YesNoAbortCommand}" />
            </FlexLayout>
            <Label Text="Rich dialogs" FontAttributes="Bold" Margin="0,14,0,0" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Margin="0,0,8,8" Text="Content dialog" Command="{Binding ContentDialogCommand}" />
                <Button Margin="0,0,8,8" Text="Task dialog" Command="{Binding TaskDialogCommand}" />
                <Button Margin="0,0,8,8" Text="Task dialog with progress" Command="{Binding ProgressDialogCommand}" />
                <Button Margin="0,0,8,8" Text="Show modal" Command="{Binding ModalCommand}" />
            </FlexLayout>
            <Label Text="Notifications" FontAttributes="Bold" Margin="0,14,0,0" TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Margin="0,0,8,8" Text="Information" Command="{Binding InformationCommand}" />
                <Button Margin="0,0,8,8" Text="Success" Command="{Binding SuccessCommand}" />
                <Button Margin="0,0,8,8" Text="Warning" Command="{Binding WarningCommand}" />
                <Button Margin="0,0,8,8" Text="Error" Command="{Binding NotificationErrorCommand}" />
            </FlexLayout>

            <Label Text="{Binding Result}" IsVisible="{Binding HasResult}" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</routeables:RouteableFor>

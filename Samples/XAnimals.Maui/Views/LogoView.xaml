<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.LogoView"
    x:DataType="vm:LogoViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <Image Source="logo" Aspect="AspectFit" MaximumWidthRequest="360" Margin="32"
           HorizontalOptions="Center" VerticalOptions="Center" SemanticProperties.Description="Routeables logo" />
</routeables:RouteableFor>

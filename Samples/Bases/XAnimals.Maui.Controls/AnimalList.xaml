<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:XAnimals.Maui"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:models="clr-namespace:XAminals.Models;assembly=XAnimals.Common"
    x:Class="XAnimals.Maui.Views.AnimalList">

    <ContentView.Resources>
        <app:WebImageConverter x:Key="WebImage" />
        <routeables:RouteableNullConverter x:Key="IsNull" />
    </ContentView.Resources>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">
        <!-- The detail view, once the router has navigated to it: it fades in on load (see AnimalDetail). -->
        <ContentView Content="{Binding CurrentView}" />

        <!-- The list, while no detail is shown. -->
        <Grid Padding="20,24,20,16" RowDefinitions="Auto,*" RowSpacing="12"
              IsVisible="{Binding CurrentView, Converter={StaticResource IsNull}}">

            <Border StrokeThickness="0" HeightRequest="48"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Lichen}, Dark={StaticResource Moss}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <SearchBar Placeholder="Enter search term"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           BackgroundColor="Transparent"
                           FontFamily="InterRegular" />
            </Border>

            <CollectionView x:Name="list" Grid.Row="1"
                            ItemsSource="{Binding FilteredAnimals}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.EmptyView>
                    <Label x:Name="noResults" Padding="4,8"
                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Animal">
                        <Border StrokeThickness="0" Padding="10,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters><Setter Property="BackgroundColor" Value="Transparent" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Lichen}, Dark={StaticResource Moss}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="16">
                                <!-- Arch-shaped image window: the one bold element of the identity. -->
                                <Border WidthRequest="56" HeightRequest="68" StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource ArchFill}, Dark={StaticResource ArchFillDark}}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="28,28,10,10" /></Border.StrokeShape>
                                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource WebImage}}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontFamily="LoraDisplay" FontSize="20" />
                                    <Label Text="{Binding Location}" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentView>

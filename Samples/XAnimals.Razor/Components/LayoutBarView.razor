@using Routeables.Abstraction
@using Routeables.Razor
@using XAnimals.ViewModels
@attribute [RouteableView(typeof(LayoutBarViewModel), route: "layout-bar")]
@inherits RouteableFor<LayoutBarView, LayoutBarViewModel>

<div class="rg-bar @(ViewModel.IsStrong ? "strong" : "")">
    <span class="rg-bar-glyph">@ViewModel.Glyph</span>
    <div class="rg-bar-text">
        <strong>@ViewModel.Title</strong>
        <span>@ViewModel.Detail</span>
    </div>
</div>

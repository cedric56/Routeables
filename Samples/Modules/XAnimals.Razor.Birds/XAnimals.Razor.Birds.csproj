<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Birds module for the Razor hosts (Blazor Server, Blazor WebAssembly, MAUI Hybrid): its two components, which draw with the
       controls of XAnimals.Razor. The shared part of the module (data, view models, the menu entry) is XAnimals.Birds. The host
       references this project: its AddGeneratedRoutes() finds the views in the assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Routeables.Razor\Routeables.Razor.csproj" />
    <ProjectReference Include="..\..\XAnimals.Razor\XAnimals.Razor.csproj" />
    <ProjectReference Include="..\XAnimals.Birds\XAnimals.Birds.csproj" />
  </ItemGroup>

</Project>

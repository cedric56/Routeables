<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.BirdsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf"
    xmlns:local="clr-namespace:XAnimals.Wpf.Views;assembly=XAnimals.Wpf.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Loads a module while the application runs: its entry appears in the menu without restarting. -->
        <Button x:Name="LoadButton" Grid.Row="0" Style="{StaticResource LoadModuleButtonStyle}" Content="Load Module" IsEnabled="{Binding CanLoadMoreBirds}" Click="OnLoadModule" />
        <local:AnimalList Grid.Row="1" NoResultsText="No birds found." />
    </Grid>
</routeables:RouteableFor>

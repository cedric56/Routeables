<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    x:Class="XAnimals.Uno.MainPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre d'en-tête : titre + bouton de bascule -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,12" Spacing="12">
            <Button x:Name="PaneToggleButton"
                    Content="☰"
                    Click="PaneToggleButton_Click"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- SplitView : nécessite x:Name pour être référencé dans le code-behind -->
        <SplitView Grid.Row="1"
                   x:Name="RootSplitView"
                   IsPaneOpen="True">
            <SplitView.Pane>
                <routeables:RouteableListView />
            </SplitView.Pane>

            <ContentControl Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </SplitView>
    </Grid>
</Page>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    x:Class="XAnimals.Uno.Views.MembersView">
    <StackPanel Margin="20,32,20,40" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Welcome}" TextWrapping="Wrap" />
        <Button Content="Sign out" Command="{Binding SignOutCommand}" />
    </StackPanel>
</routeables:RouteableFor>

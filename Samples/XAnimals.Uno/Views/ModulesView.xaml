<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    xmlns:local="using:XAnimals.Uno"
    x:Class="XAnimals.Uno.Views.ModulesView">
    <ScrollViewer>
        <StackPanel Margin="20,32,20,40" Spacing="6" MaxWidth="640">
            <TextBlock Text="Modules" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="A module is an extension method that the application calls in services. It registers its own services and adds its pages to the menu."
                       TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="Loaded" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Modules}" Visibility="{Binding HasModules, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            <Button Margin="0,6,0,0" Content="{Binding OpenText}" Command="{Binding OpenCommand}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No module is loaded. The host adds one with services.AddBirdsModule()."
                       Visibility="{Binding HasNoModules, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</routeables:RouteableFor>

<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    xmlns:local="using:XAnimals.Uno"
    x:Class="XAnimals.Uno.Views.HistoryView">
    <Grid Padding="20" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="→" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="{Binding Converter={StaticResource HistoryCardBrush}}" CornerRadius="8" Padding="10,6">
                                <Grid>
                                    <TextBlock Text="{Binding Badge}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-7,0" />
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Caption}" FontSize="9" Opacity="0.8" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Number}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Position}" TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BarStrongBrush}" BorderThickness="2" CornerRadius="18" Margin="0,4,0,0">
            <!-- The zone of the "history" region: nothing assigns the view, the control shows what the router of the region displays. -->
            <routeables:RouteableRegion Region="history" Margin="5" RouteTransitionDuration="0:0:0.22" RouteTransition="{Binding Transition.Name}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        IsHitTestVisible="False" />
        </Border>

        <StackPanel Grid.Row="2">
            <local:WrapPanel>
                <Button Margin="0,0,8,8" Content="＋ Push" Command="{Binding PushCommand}" />
                <Button Margin="0,0,8,8" Content="◀ Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
                <Button Margin="0,0,8,8" Content="Forward ▶" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" />
                <Button Margin="0,0,8,8" Content="↩ Pop" Command="{Binding PopCommand}" IsEnabled="{Binding CanGoBack}" />
            </local:WrapPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="Transition" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Transitions}" SelectedItem="{Binding Transition, Mode=TwoWay}" MinWidth="120" />
            </StackPanel>

            <CheckBox IsChecked="{Binding BlockLeaving, Mode=TwoWay}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding GuardText}" FontSize="13" TextWrapping="Wrap" MaxWidth="460" />
            </CheckBox>

            <Border Background="{Binding IsRefused, Converter={StaticResource RefusedStatusBrush}}" CornerRadius="8" Padding="10,6" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🚫" Visibility="{Binding IsRefused, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</routeables:RouteableFor>

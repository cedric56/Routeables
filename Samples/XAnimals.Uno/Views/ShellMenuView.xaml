<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    x:Class="XAnimals.Uno.Views.ShellMenuView">
    <StackPanel Margin="10" Spacing="4">
        <Grid Margin="0,0,0,6" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="◀ Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="Forward ▶" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" HorizontalAlignment="Stretch" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding Select}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="{Binding IsCurrent, Converter={StaticResource StrongBarBrush}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</routeables:RouteableFor>

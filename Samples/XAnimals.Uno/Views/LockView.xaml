<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    xmlns:local="using:XAnimals.Uno"
    x:Class="XAnimals.Uno.Views.LockView">
    <ScrollViewer>
        <StackPanel Margin="20,32,20,40" Spacing="6" MaxWidth="640">
            <TextBlock Text="Lock the menu" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="The page publishes a lock message; the menu entries are disabled until it publishes the unlock one."
                       TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="Menu" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <local:WrapPanel>
                <Button Margin="0,0,8,8" Content="Lock" Command="{Binding LockCommand}" IsEnabled="{Binding CanLock}" />
                <Button Margin="0,0,8,8" Content="Unlock" Command="{Binding UnlockCommand}" IsEnabled="{Binding CanUnlock}" />
                <Button Margin="0,0,8,8" Content="Lock for 5 seconds" Command="{Binding LockForCommand}" IsEnabled="{Binding CanLock}" />
            </local:WrapPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</routeables:RouteableFor>

<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <WasmBuildNative>true</WasmBuildNative>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Release only: the code runs compiled (AOT) instead of interpreted, which is much faster in the browser. Needs the wasm-tools workload
       (dotnet workload install wasm-tools); a publish takes longer and the download is larger. Debug and dotnet watch are not affected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0" />
  </ItemGroup>

  <!-- A browser has no system fonts for the WebAssembly app: the emoji of the menu (the glyphs of AnimalIcons) come from this font, used when
       Inter has no glyph (see Program.cs). Noto Emoji, SIL Open Font License (licenses/NotoEmoji-OFL.txt). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\NotoEmoji.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XAnimals.Avalonia\XAnimals.Avalonia.csproj" />
  </ItemGroup>
</Project>

<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.DialogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf">
    <ScrollViewer>
        <StackPanel Margin="20,12,20,40" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Dialogs" FontSize="28" FontWeight="SemiBold" />

            <TextBlock Text="Messages" Margin="0,18,0,6" FontWeight="SemiBold" Opacity="0.7" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Padding="12,4" Content="Ok" Command="{Binding OkCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Error" Command="{Binding ErrorCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Yes / No" Command="{Binding YesNoCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Ok / Cancel" Command="{Binding OkCancelCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Ok / Abort" Command="{Binding OkAbortCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Yes / No / Cancel" Command="{Binding YesNoCancelCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Yes / No / Abort" Command="{Binding YesNoAbortCommand}" />
            </WrapPanel>

            <TextBlock Text="Rich dialogs" Margin="0,14,0,6" FontWeight="SemiBold" Opacity="0.7" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Padding="12,4" Content="Content dialog" Command="{Binding ContentDialogCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Task dialog" Command="{Binding TaskDialogCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Task dialog with progress" Command="{Binding ProgressDialogCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Show modal" Command="{Binding ModalCommand}" />
            </WrapPanel>

            <TextBlock Text="Notifications" Margin="0,14,0,6" FontWeight="SemiBold" Opacity="0.7" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Padding="12,4" Content="Information" Command="{Binding InformationCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Success" Command="{Binding SuccessCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Warning" Command="{Binding WarningCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="Error" Command="{Binding NotificationErrorCommand}" />
                <Button Margin="0,0,8,8" Padding="12,4" Content="System" Command="{Binding SystemNotificationCommand}" />
            </WrapPanel>

            <TextBlock Text="{Binding Result}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"
                       Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</routeables:RouteableFor>

<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.TabsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf">
    <!-- A TabControl written here: each tab names its route (RouteableItem.Route), AttachRouteables (see the code) lets the router build the page. -->
    <TabControl x:Name="Tabs">
        <TabItem Header="Cats" routeables:RouteableItem.Route="cats" />
        <TabItem Header="Dogs" routeables:RouteableItem.Route="dogs" />
        <TabItem Header="Monkeys" routeables:RouteableItem.Route="monkeys" />
    </TabControl>
</routeables:RouteableFor>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\XAnimals.Razor.Birds\XAnimals.Razor.Birds.csproj" />
    <ProjectReference Include="..\XAnimals.Razor\XAnimals.Razor.csproj" />
    <ProjectReference Include="..\..\Routeables.Generated\Routeables.Generated.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The service worker of the system notifications must be served from the root of the site: it is copied into wwwroot (see WithAppNotifications). -->
  <Target Name="CopyNotificationWorker" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\Routeables.Razor\wwwroot\routeables-notifications-worker.js" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\" SkipUnchangedFiles="true" />
  </Target>
</Project>

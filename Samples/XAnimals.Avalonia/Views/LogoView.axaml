<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="using:Svg.Controls.Skia.Avalonia"
             xmlns:vm="using:XAnimals.ViewModels"
             x:Class="XAnimals.Avalonia.LogoView"
             x:DataType="vm:LogoViewModel"
             Background="{DynamicResource AnPaper}">

    <Viewbox Margin="32" MaxWidth="460">
        <Svg Path="/Assets/logo.svg" />
    </Viewbox>
</UserControl>

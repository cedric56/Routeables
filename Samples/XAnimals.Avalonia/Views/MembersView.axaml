<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XAnimals.ViewModels"
             x:Class="XAnimals.Avalonia.MembersView"
             x:DataType="vm:MembersViewModel"
             Background="{DynamicResource AnPaper}">

    <StackPanel Margin="20,32,20,40" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Welcome}" TextWrapping="Wrap" Foreground="{DynamicResource AnInk}" />
        <Button Content="Sign out" Classes="an" Command="{Binding SignOutCommand}" />
    </StackPanel>
</UserControl>

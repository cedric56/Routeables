<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XAnimals.ViewModels"
             x:Class="XAnimals.Avalonia.ModulesView"
             x:DataType="vm:ModulesViewModel"
             Background="{DynamicResource AnPaper}">

    <ScrollViewer>
        <StackPanel Margin="20,32,20,40" Spacing="6" MaxWidth="640">
            <TextBlock Text="Modules" FontSize="28" FontWeight="SemiBold"
                       FontFamily="{DynamicResource AnDisplayFont}" Foreground="{DynamicResource AnInk}" />
            <TextBlock Text="A module is an extension method that the application calls in services. It registers its own services and adds its pages to the menu."
                       TextWrapping="Wrap" Foreground="{DynamicResource AnMuted}" />

            <TextBlock Text="Loaded" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AnMuted}" />
            <ItemsControl ItemsSource="{Binding Modules}" IsVisible="{Binding HasModules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleItem">
                        <StackPanel Margin="0,0,0,12" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AnInk}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource AnInk}" />
                            <Button Margin="0,6,0,0" Content="{Binding OpenText}" Classes="an" Command="{Binding OpenCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No module is loaded. The host adds one with services.AddBirdsModule()."
                       IsVisible="{Binding HasNoModules}" TextWrapping="Wrap" Foreground="{DynamicResource AnInk}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

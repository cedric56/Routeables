<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Routeables.Avalonia</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0-preview.1</Version>
    <Description>Routeables for Avalonia: view-model-first routing, routed views and regions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
    <InternalsVisibleTo Include="Routeables.Avalonia.Services" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Regions\Routeables.Regions.csproj" />
    <ProjectReference Include="..\Routeables.Core\Routeables.Core.csproj" />
    <ProjectReference Include="..\Routeables.Services\Routeables.Services.csproj" />
  </ItemGroup>
</Project>

@using Routeables.Blazor
@using Routeables.Blazor.Services
@using global::MudBlazor
@* Lifecycle, theme, URL sync, Title, _drawerOpen, DrawerToggle, OnNavClick and Service come from MainLayoutBase. *@
@inherits MainLayoutBase

<MudThemeProvider IsDarkMode="Service.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false" />
<MudSnackbarProvider />
<RouteableModalHost />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        @Title
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen">
        <MudNavMenu>
            @foreach (var item in MainViewModel.Routeables)
            {
                <MudNavLink Disabled="@item.IsLock" OnClick="@(() => OnNavClick(item))">
                    @item.DisplayName
                </MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>
   
    <MudMainContent>
    @if (MainViewModel.CurrentView is RouteableFor view)
        {
            @view.Render()
        }
    </MudMainContent>
</MudLayout>

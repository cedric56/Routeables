@using MudBlazor
@using Routeables.Abstraction
@using Routeables.Razor
@using global::MudBlazor
@using Routeables.Services
@implements IDisposable

<MudDialog>
    <TitleContent>
        @if (!string.IsNullOrWhiteSpace(Parameters.Title))
        {
            <MudText Typo="Typo.h6">@Parameters.Title</MudText>
        }
    </TitleContent>

    <DialogContent>
        <div class="dialog-header-row">
            @if (Parameters.IconSource is RouteableFor icon)
            {
                <div class="dialog-header-icon">
                    @icon.Render()
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Parameters.Header))
            {
                <MudText Typo="Typo.h5" class="dialog-header-title">@Parameters.Header</MudText>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Parameters.SubHeader))
        {
            <div class="dialog-subheader">@Parameters.SubHeader</div>
        }
        @if (Parameters.Content is RouteableFor content)
        {
            @content.Render()
        }
        @if (Parameters.ShowProgressBar)
        {
            <div class="dialog-progress"><div class="dialog-progress-indeterminate"></div></div>
        }
        @if (Parameters.ShowsFooter)
        {
            @if (Parameters.IsFooterCollapsible)
            {
                <MudButton class="dialog-footer-toggle" onclick="ToggleFooter">
                    @(_footerExpanded ? "Less details" : "More details")
                </MudButton>
            }
            @if (_footerExpanded && Parameters.Footer is RouteableFor footer)
            {
                @footer.Render()
            }
        }

    </DialogContent>

    <DialogActions>
        @foreach (var button in Session.Buttons)
        {
            var current = button;
            <MudButton class="dialog-action"
                       Color="Color.Default"
                       OnClick="@(() => current.Press())">
                @current.Text
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .dialog-header-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dialog-header-icon {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .dialog-header-title {
        flex: 1 1 auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@code {
    private bool _footerExpanded;

    /// <summary>The buttons (one per result asked) and when the dialog may close, the same on every host.</summary>
    private RouteableTaskDialogSession Session { get; set; } = default!;

    /// <summary>
    /// Lifecycle hook called when the component is initialized, setting initial footer expansion
    /// state and starting the session of the dialog.
    /// </summary>
    protected override void OnInitialized()
    {
        _footerExpanded = Parameters.FooterStartsExpanded;

        Session = new RouteableTaskDialogSession(Parameters, Results, () => Instance.Close(Session.Result));
        Session.Opening();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
            Session.Opened();
    }

    /// <summary>
    /// Toggles the expanded/collapsed state of the task dialog footer.
    /// </summary>
    private void ToggleFooter() => _footerExpanded = !_footerExpanded;

    /// <summary>
    /// Gets or sets the cascading MudBlazor dialog instance used to control and close the dialog.
    /// </summary>
    [CascadingParameter]
    public required IMudDialogInstance Instance { get; set; }

    /// <summary>
    /// Gets or sets the parameters governing the task dialog's headers, icon, content, footer, and callbacks.
    /// </summary>
    [Parameter]
    public required RouteableTaskDialog Parameters { get; set; }

    /// <summary>
    /// Gets or sets the available standard result options presented as action buttons.
    /// </summary>
    [Parameter]
    public required RouteableTaskDialogResult[] Results { get; set; }

    /// <summary>The dialog is closed and removed: Closed is told.</summary>
    public void Dispose() => Session?.Release();
}

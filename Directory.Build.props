<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The version of every package of the repository, in one place: VersionSuffix is empty for a release. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- API still moving: a preview. Empty the suffix for the 1.0.0 release. -->
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.1</VersionSuffix>
    <!-- The SDK computes Version later than the body of a project, where Routeables.Core.csproj hands it to its nuspec: set it here. -->
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
  </PropertyGroup>

  <!-- What every package of the repository shares. Id, authors, readme and license are set in each project. -->
  <PropertyGroup>
    <Copyright>Copyright (c) 2026 Cedric</Copyright>
    <PackageProjectUrl>https://github.com/cedric56/Routeables</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cedric56/Routeables.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>routing;navigation;mvvm;viewmodel;blazor;maui;avalonia;uno;wpf</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The .pdb is inside the package, next to the .dll (no separate .snupkg to publish), with Source Link: a consumer can step into the library from the debugger. -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    On the CI build (-p:CiBuild=true) these warnings fail the build: use of an obsolete API, a cached route with parameters
    (ROUT201), and the trimming / AOT analyzers the libraries opt in to with IsAotCompatible. Locally they stay warnings.
  -->
  <PropertyGroup Condition="'$(CiBuild)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);CS0618;ROUT201;IL2026;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <!-- The XML documentation of the libraries (IntelliSense in the IDE of the user): next to the .dll in a package, and in the
       "Routeables" package through the nuspec. This is in the props, not in the targets: the SDK computes DocumentationFile from GenerateDocumentationFile before the targets are read. Not the tests, benchmarks, samples or the generator.
       A missing or malformed comment (CS1570-CS1592) stays a warning, whatever TreatWarningsAsErrors says: it must not stop a build. -->
  <PropertyGroup Condition="('$(MSBuildProjectName.StartsWith(`Routeables.`))' == 'true' And '$(MSBuildProjectName)' != 'Routeables.Test' And '$(MSBuildProjectName)' != 'Routeables.Benchmarks' And '$(MSBuildProjectName)' != 'Routeables.AotSmoke' And '$(MSBuildProjectName)' != 'Routeables.Generated') Or '$(MSBuildProjectName.StartsWith(`Reshapes.`))' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735;CS0419</WarningsNotAsErrors>
  </PropertyGroup>
</Project>

<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The version of every package in the repository, in one place. VersionSuffix is empty for a release. -->
  <PropertyGroup>
    <VersionPrefix>3.0.0</VersionPrefix>
    <!-- A stable release has no suffix. Build a preview with -p:VersionSuffix=preview.1: nothing to edit here. -->
    <!-- The SDK computes Version after the project body, where Routeables.Core.csproj hands it to its nuspec, so set it here. -->
    <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
    <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
  </PropertyGroup>

  <!-- The last published version. CI (job "API compatibility") checks the packages against it, see VERSIONING.md. Raise it at each release. -->
  <PropertyGroup>
    <ApiBaselineVersion>2.1.0</ApiBaselineVersion>
  </PropertyGroup>

  <!-- What every package in the repository shares. Id, authors, readme and license are set in each project. -->
  <PropertyGroup>
    <Copyright>Copyright (c) 2026 Cédric Boutin</Copyright>
    <PackageProjectUrl>https://github.com/cedric56/Routeables</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cedric56/Routeables.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>routing;navigation;mvvm;viewmodel;blazor;maui;avalonia;uno;wpf</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The .pdb ships inside the package next to the .dll (no separate .snupkg), with Source Link, so consumers can step into the library in the debugger. -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    On the CI build (-p:CiBuild=true) these warnings fail the build: use of an obsolete API, a cached route with parameters (ROUT201),
    and the trimming / AOT analyzers the libraries opt in to with IsAotCompatible. Locally they stay warnings.
  -->
  <PropertyGroup Condition="'$(CiBuild)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);CS0618;ROUT201;IL2026;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <!-- XML documentation for the libraries (IntelliSense): next to the .dll in a package, and in the "Routeables" package through the nuspec.
       It is in the props, not the targets, because the SDK computes DocumentationFile from GenerateDocumentationFile before the targets are read.
       Not for the tests, benchmarks, samples or the generator.
       A missing or malformed comment (CS1570-CS1592) stays a warning whatever TreatWarningsAsErrors says: it must not stop a build. -->
  <PropertyGroup Condition="('$(MSBuildProjectName.StartsWith(`Routeables.`))' == 'true' And '$(MSBuildProjectName.StartsWith(`Routeables.Test`))' != 'true' And '$(MSBuildProjectName)' != 'Routeables.Benchmarks' And '$(MSBuildProjectName)' != 'Routeables.AotSmoke' And '$(MSBuildProjectName)' != 'Routeables.Generated') Or '$(MSBuildProjectName.StartsWith(`Reshapes.`))' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735;CS0419</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Routeables.Native (Maui.Essentials) brings a newer AndroidX Lifecycle.Runtime than Uno's Lifecycle.Process asks for (NU1608). The application
       resolves that AndroidX package set; it is not a defect of this repository, so it stays a warning. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1608</WarningsNotAsErrors>
  </PropertyGroup>
</Project>

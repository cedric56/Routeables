<Project Sdk="Uno.Sdk">

  <!--
    UI tests of the Uno host: an Uno application (the desktop head, Skia) that runs the tests inside itself with the Uno runtime tests
    engine (the one of Uno's own SamplesApp), on the real WinUI controls of Routeables.Uno. The tests show on the screen, in the page below the runner.

    Run it and press the button of the runner, or in CI, without a screen, results written to a file:
      dotnet build Tests/Routeables.Test.Uno/Routeables.Test.Uno.csproj -c Release
      UNO_RUNTIME_TESTS_RUN_TESTS='{}' UNO_RUNTIME_TESTS_OUTPUT_PATH=$PWD/uno-results.xml \
        xvfb-run dotnet Tests/Routeables.Test.Uno/bin/Release/net10.0-desktop/Routeables.Test.Uno.dll
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Routeables.Test.Uno</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationTitle>Routeables.Test.Uno</ApplicationTitle>
    <ApplicationId>com.routeables.test.uno</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <UnoFeatures></UnoFeatures>
    <!-- Routeables.Uno is built on Uno.WinUI 6.7.135: the head must not use an older one. -->
    <UnoVersion>6.7.135</UnoVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- The engine, and the MSTest attributes the tests are written with ([TestClass], [TestMethod]).
         The versions could not be checked where this project was written: pin them to the ones restored. -->
    <PackageReference Include="Uno.UI.RuntimeTests.Engine" Version="*-*" />
    <PackageReference Include="MSTest.TestFramework" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <UnoIcon Include="Assets\Brand\icon.svg" Color="#4A22C8" />
    <UnoSplashScreen Include="Assets\Brand\splash.svg" BaseSize="128,128" Color="#4A22C8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Routeables.Uno\Routeables.Uno.csproj" />
  </ItemGroup>

</Project>

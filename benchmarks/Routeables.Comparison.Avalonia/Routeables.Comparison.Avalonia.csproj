<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The same application navigation as Routeables.Comparison, inside an Avalonia application with no screen (Avalonia.Headless): every page is
    a real view (a control with a text) in a real window, built by the library the way it builds it, and the layout of the window is run after
    each step. Routeables and ReactiveUI routing are here; Prism is in Routeables.Comparison.Prism (it asks for Avalonia 11, these two for 12).
    The service of your own is left out: it has no view to build.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableAvaloniaXamlCompilation>false</EnableAvaloniaXamlCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" VersionOverride="12.0.1" />
    <PackageReference Include="ReactiveUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Comparison\Routeables.Comparison.csproj" />
    <ProjectReference Include="..\..\src\Routeables.Avalonia\Routeables.Avalonia.csproj" />
  </ItemGroup>

</Project>

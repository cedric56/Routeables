<Project>

  <!-- The README of a project is the readme of its package (PackageReadmeFile is set in the project).
       Lives in .targets: the SDK adds README.md to None only after .props are read, so Remove + Include works whether or not the glob already added it. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The icon of the package. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(PackageIcon)' != ''">
    <None Include="$(MSBuildThisFileDirectory)Images/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- The XML documentation of the libraries (IntelliSense in the IDE of the user): next to the .dll in a package, and in the
       "Routeables" package through the nuspec. Not the tests, benchmarks, samples or the generator.
       A missing or malformed comment (CS1570-CS1592) stays a warning, whatever TreatWarningsAsErrors says: it must not stop a build. -->
  <PropertyGroup Condition="('$(MSBuildProjectName.StartsWith(`Routeables.`))' == 'true' And '$(MSBuildProjectName)' != 'Routeables.Test' And '$(MSBuildProjectName)' != 'Routeables.Benchmarks' And '$(MSBuildProjectName)' != 'Routeables.AotSmoke' And '$(MSBuildProjectName)' != 'Routeables.Generated') Or '$(MSBuildProjectName.StartsWith(`Reshapes.`))' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1710;CS1711;CS1712</WarningsNotAsErrors>
  </PropertyGroup>
</Project>

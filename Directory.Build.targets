<Project>

  <!-- A project's README is its package's readme (PackageReadmeFile is set in the project).
       This is in .targets because the SDK adds README.md to None only after the .props are read, so Remove + Include works whether or not the glob already added it. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The samples reference the source generator as a project, not through the package. This is the same rule as build/Routeables.targets in
       Routeables.Core, so their Android and iOS applications (compiled as libraries) register their generated routes too. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RouteablesAutoRegister" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RouteablesAutoRegister)' == '' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
    <RouteablesAutoRegister>true</RouteablesAutoRegister>
  </PropertyGroup>

  <!-- On Android, OutputType is Library when the compiler runs, while AndroidApplication is true. The compiler's config file that carries the
       property is written by GenerateMSBuildEditorConfigFileCore, and the dependencies of GenerateMSBuildEditorConfigFile run before a target
       that only has it in BeforeTargets, so this target runs before the Core target. It makes the same decision as above, but just before the
       compiler runs: a mobile project can change its OutputType after the properties above were read, and the Android SDK identifies an
       application by AndroidApplication. Without this the generator wrote no registration for the MAUI Android application
       ("No view is registered under the key ..."). -->
  <Target Name="RouteablesAutoRegisterOfApplication" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFileCore;CoreCompile"
          Condition="'$(RouteablesAutoRegister)' == '' And ('$(AndroidApplication)' == 'true' Or '$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
    <PropertyGroup>
      <RouteablesAutoRegister>true</RouteablesAutoRegister>
    </PropertyGroup>
  </Target>

  <!-- The icon of the package. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(PackageIcon)' != ''">
    <None Include="$(MSBuildThisFileDirectory)images/icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>

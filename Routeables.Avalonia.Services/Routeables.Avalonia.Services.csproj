<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Routeables.Avalonia.Services</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <PackageId>Routeables.Avalonia.Services</PackageId>
    <Authors>Cedric</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Dialogs, content dialogs, task dialogs, modals and notifications for Routeables on Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Core\Routeables.Core.csproj" PrivateAssets="none" />
    <ProjectReference Include="..\Routeables.Avalonia\Routeables.Avalonia.csproj" />
  </ItemGroup>
</Project>

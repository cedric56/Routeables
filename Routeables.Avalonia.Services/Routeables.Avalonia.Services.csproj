<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Routeables.Avalonia.Services</PackageId>
    <RootNamespace>Routeables.Avalonia.Services</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0-preview.1</Version>
    <Description>Dialogs, content dialogs, task dialogs, modals and notifications for Routeables on Avalonia.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Avalonia\Routeables.Avalonia.csproj" />
    <ProjectReference Include="..\Routeables.Abstraction\Routeables.Abstraction.csproj" />
    <ProjectReference Include="..\Routeables.Services\Routeables.Services.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The types keep the Routeables.Abstraction namespace, so moving them out of that assembly changes no using. -->
    <RootNamespace>Routeables.Abstraction</RootNamespace>
    <!--<AllowUnsafeBlocks>true</AllowUnsafeBlocks>-->
    <Version>1.0.0</Version>
    <!-- Shipped inside the Routeables package (Routeables.Core/Routeables.nuspec), not as a package of its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Routeables.Test" />
    <InternalsVisibleTo Include="Routeables.Razor" />
    <InternalsVisibleTo Include="Routeables.Maui" />
    <InternalsVisibleTo Include="Routeables.Avalonia" />
    <InternalsVisibleTo Include="Routeables.Uno" />
    <InternalsVisibleTo Include="Routeables.Avalonia.Services" />
    <InternalsVisibleTo Include="Routeables.Uno.Services" />
    <InternalsVisibleTo Include="Routeables.Maui.Services" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Routeables.Abstraction\Routeables.Abstraction.csproj" />
  </ItemGroup>
</Project>

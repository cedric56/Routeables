<UserControl
    x:Class="XAnimals.Wpf.Views.AnimalDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:XAnimals.Wpf.Views">

    <!-- The text takes the colour of the theme: inside a ScrollViewer it stayed black on the dark theme. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <StackPanel Margin="20,28,20,40" MaxWidth="640" HorizontalAlignment="Center">
            <Border Width="260" Height="330" CornerRadius="130,130,18,18" Background="{StaticResource PlainCardBrush}">
                <Border CornerRadius="130,130,18,18" views:AnimalPicture.Url="{Binding Animal.PhotoUrl}">
                </Border>
            </Border>
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="{Binding Animal.Name}" FontFamily="{DynamicResource AnDisplayFont}" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Animal.Location}" FontWeight="SemiBold" Foreground="{StaticResource AnSaffron}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Animal.Details}" Margin="0,12,0,18" LineHeight="24" TextWrapping="Wrap" />
                <Button Content="Back" HorizontalAlignment="Center" Style="{StaticResource AnButtonStyle}" Click="OnBack" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

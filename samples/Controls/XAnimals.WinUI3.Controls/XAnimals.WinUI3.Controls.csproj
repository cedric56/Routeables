<Project Sdk="Microsoft.NET.Sdk">

  <!-- The controls the animal pages of the WinUI 3 sample are made of (the list, the detail). They draw with the resources of the application (PlainCardBrush, the AnimalImage converter), found when they are shown. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Routeables.WinUI3\Routeables.WinUI3.csproj" />
    <ProjectReference Include="..\..\Bases\XAnimals.Common\XAnimals.Common.csproj" />
    <ProjectReference Include="..\..\Bases\XAnimals.ViewModels\XAnimals.ViewModels.csproj" />
  </ItemGroup>

</Project>

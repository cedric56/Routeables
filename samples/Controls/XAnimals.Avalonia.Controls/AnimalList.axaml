<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XAnimals.Common;assembly=XAnimals.Common"
             xmlns:models="using:XAnimals.Models"
             xmlns:ail="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="XAnimals.Avalonia.AnimalList"
             x:DataType="vm:AnimalsViewModel"
             Background="{DynamicResource AnPaper}">

    <Grid>
        <!-- The detail is not drawn here: the page is shown by a RouteableRegion (the main view), which displays the current view of the
             router, and a view has one parent. -->

        <DockPanel Margin="20,24,20,16">

            <TextBox Classes="an"
                     DockPanel.Dock="Top"
                     Margin="0,0,0,16"
                     PlaceholderText="Enter search term"
                     Text="{Binding SearchText, Mode=TwoWay}" />

            <TextBlock x:Name="noResults"
                       DockPanel.Dock="Top"
                       Margin="4,8"
                       Foreground="{DynamicResource AnMuted}"
                       IsVisible="{Binding !FilteredAnimals.Count}" />

            <ListBox x:Name="lb"
                     Classes="an"
                     Background="Transparent"
                     ItemsSource="{Binding FilteredAnimals}"
                     SelectedItem="{Binding SelectedAnimal}"
                     SelectionChanged="ListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Animal">
                        <Grid ColumnDefinitions="56,*" ColumnSpacing="16">
                            <Border Classes="arch" Width="56" Height="68" CornerRadius="28,28,10,10">
                                <Image Stretch="UniformToFill"
                                       ail:ImageLoader.Source="{Binding ThumbnailUrl}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{DynamicResource AnDisplayFont}"
                                           FontSize="20" />
                                <TextBlock Text="{Binding Location}"
                                           Opacity="0.7"
                                           FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>

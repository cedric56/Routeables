@page "/{**path}"
@inject IMainViewModel MainViewModel
@inject IRouter Router
@inject IServiceProvider ServiceProvider
@using Routeables.Abstraction
@using Routeables.AspNetCore
@using XAnimals.WebApplication.Pages
@*
    Not meant to be seen: this page only gives endpoint routing a route for "/" and for
    every other address, so that it does not return 404. What the user sees is drawn by
    the layout (MainLayout) from the Routeables router; the layout does not render this
    body. Do not remove it unless the application has its own page with these routes.
*@
<h1>XAnimals</h1>
@model ShellModel
@{
    MainViewModel.SelectFirst();
    var view = MainViewModel.Routeable?.View;
    var vm = MainViewModel.Routeable?.ViewModel;
    var path = view?.ToString();//.TemplatePath();
}
@if (path is { } && vm is not null)
{
    @await Html.PartialAsync("~/Views/Cats/Index.cshtml", vm, ViewData)
}

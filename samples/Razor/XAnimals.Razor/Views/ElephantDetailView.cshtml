@using Routeables.Abstraction
@model ElephantDetailViewModel
@attribute [RouteableView(typeof(ElephantDetailViewModel), "/elephants/{name}")]
@{ ViewData["Title"] = Model.Animal?.Name ?? "Elephant"; ViewData["Species"] = "elephants"; }
@await Html.PartialAsync("~/Views/Shared/_AnimalDetail.cshtml", Model, ViewData)

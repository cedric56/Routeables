@using Routeables.Abstraction
@model MonkeyDetailViewModel
@attribute [RouteableView(typeof(MonkeyDetailViewModel), "/monkeys/{name}")]
@{ ViewData["Title"] = Model.Animal?.Name ?? "Monkey"; ViewData["Species"] = "monkeys"; }
@await Html.PartialAsync("~/Views/Shared/_AnimalDetail.cshtml", Model, ViewData)

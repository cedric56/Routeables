@model AnimalDetailViewModel
@{ var species = (string)(ViewData["Species"] ?? "cats"); }
<div class="monkey-detail">
@if (Model.Animal is null)
{
    <h1 class="title">Animal not found</h1><p class="body-text">This animal was not found.</p>
}
else
{
    <h1 class="title">@Model.Animal.Name</h1>
    <p class="location">@Model.Animal.Location</p>
    <img src="@Model.Animal.PhotoUrl" alt="@Model.Animal.Name" width="260" height="330" />
    <p class="body-text">@Model.Animal.Details</p>
}
@if (ViewData["Region"] is string region)
{
    <form method="post"><input type="hidden" name="target" value="@region" /><button type="submit" name="do" value="back" class="back-btn">Back</button></form>
}
else
{
    <a class="back-btn" href="/@species">Back</a>
}
</div>

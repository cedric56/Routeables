@page "/{**path}"
@model XAnimals.Razor.Pages.MainViewPageModel
@using Routeables.Abstraction
@using XAnimals.Razor.Pages

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Routeables Animals";

    // The menu marks the first segment of the address: /cats/Tom is still in Cats.
    var current = "/" + (Model.Url.Split('?')[0].Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "");
}

<div class="shell">
    @* The side panel: one entry per entry of the main view model, as in the other samples. It slides away with the button of the header. *@
    <nav class="drawer" id="drawer" aria-label="Menu">
        @foreach (var entry in Model.MenuEntries)
        {
            var route = MainViewPageModel.Address(entry.Route);
            var active = string.Equals(route, current, StringComparison.OrdinalIgnoreCase);
            if (entry.IsLock)
            {
                @* A page published a lock (Features): the entry cannot be followed until it publishes the unlock. *@
                <span class="drawer-link locked" title="Locked">
                    @if (entry.Icon is string lockedGlyph) { <span class="drawer-icon" aria-hidden="true">@lockedGlyph</span> }
                    <span class="drawer-name">@entry.DisplayName</span>
                </span>
            }
            else
            {
                <a href="@route" class="drawer-link @(active ? "active" : null)" aria-current="@(active ? "page" : null)">
                    @if (entry.Icon is string glyph) { <span class="drawer-icon" aria-hidden="true">@glyph</span> }
                    <span class="drawer-text">
                        <span class="drawer-name">@entry.DisplayName</span>
                        @if (entry.HasDescription) { <span class="drawer-description">@entry.Description</span> }
                    </span>
                </a>
            }
        }
    </nav>

    <div class="shell-content">
<div style="padding: 20px;">
    @if (Model.NotFound)
    {
        <h1>Page not found</h1>
        <p>No route matched: @Request.Path</p>
    }
    else if (Model.Router.CurrentView is { } view)
    {
        @await Html.PartialAsync(MainViewPageModel.ViewName(view), Model.Router.CurrentViewModel)
    }
    else if (Model.Main.Routeable?.View is { } entryView)
    {
        @await Html.PartialAsync(MainViewPageModel.ViewName(entryView), Model.Main.Routeable.ViewModel)
    }
    else
    {
        <h1>Page not found</h1>
        <p>No route matched: @Model.Url</p>
    }
</div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/_Interactions.cshtml", Model.Interactions)

<script>
    // Show or hide the side panel, and remember it.
    (function () {
        var root = document.documentElement, toggle = document.getElementById('drawerToggle');
        function sync() { toggle.setAttribute('aria-expanded', root.classList.contains('drawer-closed') ? 'false' : 'true'); }
        sync();
        toggle.addEventListener('click', function () {
            root.classList.toggle('drawer-closed');
            try { localStorage.setItem('xanimals.drawer', root.classList.contains('drawer-closed') ? 'closed' : 'open'); } catch (e) { }
            sync();
        });
    })();
</script>

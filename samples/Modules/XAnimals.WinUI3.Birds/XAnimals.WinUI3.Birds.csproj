<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Birds module for the WinUI 3 host: its two pages, which draw with the controls of XAnimals.WinUI3.Controls. The shared part (data, view models, the menu entry) is XAnimals.Birds. The head references this project: its AddGeneratedRoutes() finds the pages. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Routeables.Generated\Routeables.Generated.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\..\src\Routeables.WinUI3\Routeables.WinUI3.csproj" />
    <ProjectReference Include="..\..\Controls\XAnimals.WinUI3.Controls\XAnimals.WinUI3.Controls.csproj" />
    <ProjectReference Include="..\XAnimals.Birds\XAnimals.Birds.csproj" />
  </ItemGroup>

</Project>

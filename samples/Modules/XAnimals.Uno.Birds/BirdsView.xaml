<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    xmlns:local="using:XAnimals.Uno.Views"
    x:Class="XAnimals.Uno.Views.BirdsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Loads a module while the application runs: its entry appears in the menu without restarting. -->
        <Button x:Name="LoadButton" Grid.Row="0" Style="{StaticResource LoadModuleButtonStyle}" Content="Load Module" IsEnabled="{Binding CanLoadMoreBirds}" Click="OnLoadModule" />
        <local:AnimalList Grid.Row="1" NoResultsText="No birds found." />
    </Grid>
</routeables:RouteableFor>

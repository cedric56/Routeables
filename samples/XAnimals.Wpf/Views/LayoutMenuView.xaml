<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.LayoutMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf">
    <StackPanel Margin="10">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="◀ Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
            <Button Grid.Column="1" Content="Forward ▶" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding Select}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            Background="{Binding IsCurrent, Converter={StaticResource StrongBarBrush}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</routeables:RouteableFor>

<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.PetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:XAnimals.Wpf.Views;assembly=XAnimals.Wpf.Controls"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf">
    <!-- The card of one adopted animal; the adoption zone puts them side by side. -->
    <Border Background="{StaticResource PlainCardBrush}" CornerRadius="16" Padding="14" Margin="0,0,12,12" VerticalAlignment="Top">
        <StackPanel HorizontalAlignment="Center">
            <Border Width="150" Height="190" CornerRadius="75,75,12,12" Margin="0,0,0,6" views:AnimalPicture.Url="{Binding Animal.PhotoUrl}">
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Center" />
            <TextBlock Text="{Binding Location}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Center" />
            <TextBlock Text="{Binding Glyph}" FontSize="22" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</routeables:RouteableFor>

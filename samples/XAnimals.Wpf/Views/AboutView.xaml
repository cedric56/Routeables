<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf"
    xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="White" CornerRadius="16" Padding="16" Margin="20,20,20,0" HorizontalAlignment="Left">
                <svg:SvgViewbox Source="/Assets/logo.svg" Height="140" />
            </Border>
            <StackPanel Margin="20,32,20,40" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock FontSize="28">
                    <Run Text="Routeables Animals" FontWeight="SemiBold" />
                    <Run Text=" 1.0" FontSize="16" />
                </TextBlock>

                <TextBlock Text="Links" Margin="0,18,0,6" FontWeight="SemiBold" Opacity="0.7" />
                <WrapPanel>
                    <Button Margin="0,0,8,8" Padding="12,4" Content="Learn more" Click="OnLearnMoreClick" />
                    <Button Margin="0,0,8,8" Padding="12,4" Content="Polar bears" Command="{Binding PolarBearsCommand}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</routeables:RouteableFor>

<routeables:RouteableFor
    x:Class="XAnimals.Wpf.Views.RegionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="clr-namespace:Routeables.Wpf;assembly=Routeables.Wpf">
    <!-- An application of its own: four zones, four routers. Each zone only has a name, and receives whatever the router of that
         region displays. Every page in it routes its own region: nothing here assigns a view to a zone. -->
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <routeables:RouteableRegion Grid.ColumnSpan="2" Region="shell-header" HorizontalContentAlignment="Stretch" />

        <Border Grid.Row="1" Background="{StaticResource PlainCardBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="CollapseButton" Margin="6" Padding="10,2" HorizontalAlignment="Right"
                        Content="«" Click="OnCollapseClick" ToolTip="Reduce the panel"
                        AutomationProperties.Name="Reduce the panel" />
                <ScrollViewer x:Name="LeftScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <routeables:RouteableRegion Region="shell-left" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
                <!-- One route made of segments: the logo in the content, the author in the footer, the copyright in the left panel. -->
                <Button x:Name="CreditsButton" Grid.Row="2" Margin="10" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="{Binding CreditsText}" Command="{Binding CreditsCommand}" />
            </Grid>
        </Border>

        <routeables:RouteableRegion Grid.Row="1" Grid.Column="1" Region="shell-content"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <routeables:RouteableRegion Grid.Row="2" Grid.ColumnSpan="2" Region="shell-footer" HorizontalContentAlignment="Stretch" />
    </Grid>
</routeables:RouteableFor>

<?xml version="1.0" encoding="utf-8" ?>
<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:routeables="clr-namespace:Routeables.Maui;assembly=Routeables.Maui"
    xmlns:vm="clr-namespace:XAnimals.ViewModels;assembly=XAnimals.ViewModels"
    x:Class="XAnimals.Maui.Views.LayoutBarView"
    x:DataType="vm:LayoutBarViewModel">

    <!-- One view for the header and the footer: the strong one is the header. -->
    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Lichen}, Dark={StaticResource Moss}}">
        <Grid.Triggers>
            <DataTrigger TargetType="Grid" Binding="{Binding IsStrong}" Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            </DataTrigger>
        </Grid.Triggers>
        <HorizontalStackLayout Spacing="12" Padding="14,8">
            <Label Text="{Binding Glyph}" FontSize="28" VerticalOptions="Center" />
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="{Binding Title}" FontFamily="Lora" FontSize="17" LineBreakMode="WordWrap">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsStrong}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Text="{Binding Detail}" FontSize="12" Opacity="0.85" LineBreakMode="WordWrap">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsStrong}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Grid>
</routeables:RouteableFor>

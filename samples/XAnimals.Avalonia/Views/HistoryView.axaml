<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:routeables="using:Routeables.Avalonia"
             xmlns:vm="using:XAnimals.ViewModels"
             x:Class="XAnimals.Avalonia.HistoryView"
             x:DataType="vm:HistoryViewModel"
             Background="{DynamicResource AnPaper}">
    
        <Grid RowDefinitions="Auto, *, Auto">
            <StackPanel Grid.Row="0">
                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryItem">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="→" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                                           IsVisible="{Binding HasPrevious}" Foreground="{DynamicResource AnMuted}" />
                                <Border Classes="card" Classes.current="{Binding IsCurrent}" Classes.ahead="{Binding IsAhead}">
                                    <Grid>
                                        <TextBlock Text="{Binding Badge}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-7,0" />
                                        <StackPanel HorizontalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Caption}" FontSize="9" Opacity="0.8" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Number, StringFormat='#{0}'}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            
                    <Border Grid.Row="1" x:Name="FrameHost" BorderBrush="{DynamicResource AnCanopy}" BorderThickness="2" CornerRadius="18" ClipToBounds="True" Margin="0,4,0,0">
                        <!-- The zone of the "history" region: nothing assigns the view, the control shows what the router of the region displays.
                             It is laid out at a design size, then scaled to the room the frame has (RenderTransform, see the code-behind). -->
                        <routeables:RouteableRegion x:Name="Frame" Region="history" Transition="{Binding Transition}"
                                                    Margin="5"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    IsHitTestVisible="False">
                            <routeables:RouteableRegion.PageTransition>
                                <CrossFade Duration="0:0:0.22" />
                            </routeables:RouteableRegion.PageTransition>
                        </routeables:RouteableRegion>
                    </Border>
            <StackPanel Grid.Row="2">
                <WrapPanel>
                    <Button Margin="0,0,8,8" Content="＋ Push" Classes="an" Command="{Binding PushCommand}" />
                    <Button Margin="0,0,8,8" Content="◀ Back" Classes="an" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
                    <Button Margin="0,0,8,8" Content="Forward ▶" Classes="an" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}" />
                    <Button Margin="0,0,8,8" Content="↩ Pop" Classes="an" Command="{Binding PopCommand}" IsEnabled="{Binding CanGoBack}" />
                </WrapPanel>
    
                <!-- The transition of the frame; "Push (SlideUp)" asks for its own, for that one navigation. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="Transition" VerticalAlignment="Center" Foreground="{DynamicResource AnInk}" />
                    <ComboBox ItemsSource="{Binding Transitions}" SelectedItem="{Binding Transition}" />
                </StackPanel>

                <CheckBox IsChecked="{Binding BlockLeaving}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding GuardText}" FontSize="13" TextWrapping="Wrap" MaxWidth="460" Foreground="{DynamicResource AnInk}" />
                </CheckBox>

                <Border Classes="status" Classes.refused="{Binding IsRefused}" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🚫" IsVisible="{Binding IsRefused}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource AnInk}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
</UserControl>

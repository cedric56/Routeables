<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XAnimals.ViewModels"
             xmlns:routeables="using:Routeables.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="XAnimals.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
      <Design.DataContext>
        <vm:MainViewModel />
      </Design.DataContext>

	<DrawerPage>
		 <DrawerPage.Header>
			 <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
				 <TextBlock Text="{Binding CurrentTitle}" VerticalAlignment="Center" />
				 <Button Grid.Column="1" Content="&#x25D0;" Click="OnThemeToggle" VerticalAlignment="Center"
						 ToolTip.Tip="Switch between the light and the dark theme" />
			 </Grid>
		 </DrawerPage.Header>
		 <DrawerPage.Drawer>
		    <routeables:RouteableMenu/>
		</DrawerPage.Drawer>
		<routeables:RouteableRegion/>
	</DrawerPage>
</UserControl>

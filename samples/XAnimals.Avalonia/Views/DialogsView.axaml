<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XAnimals.ViewModels"
             x:Class="XAnimals.Avalonia.DialogsView"
             x:DataType="vm:DialogsViewModel"
             Background="{DynamicResource AnPaper}">

    <ScrollViewer>
        <StackPanel Margin="20,32,20,40" Spacing="6" MaxWidth="640">            
            <TextBlock Text="Messages" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AnMuted}" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Content="Ok" Classes="an" Command="{Binding OkCommand}" />
                <Button Margin="0,0,8,8" Content="Error" Classes="an" Command="{Binding ErrorCommand}" />
                <Button Margin="0,0,8,8" Content="Yes / No" Classes="an" Command="{Binding YesNoCommand}" />
                <Button Margin="0,0,8,8" Content="Ok / Cancel" Classes="an" Command="{Binding OkCancelCommand}" />
                <Button Margin="0,0,8,8" Content="Ok / Abort" Classes="an" Command="{Binding OkAbortCommand}" />
                <Button Margin="0,0,8,8" Content="Yes / No / Cancel" Classes="an" Command="{Binding YesNoCancelCommand}" />
                <Button Margin="0,0,8,8" Content="Yes / No / Abort" Classes="an" Command="{Binding YesNoAbortCommand}" />
            </WrapPanel>
            <TextBlock Text="Rich dialogs" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AnMuted}" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Content="Content dialog" Classes="an" Command="{Binding ContentDialogCommand}" />
                <Button Margin="0,0,8,8" Content="Task dialog" Classes="an" Command="{Binding TaskDialogCommand}" />
                <Button Margin="0,0,8,8" Content="Task dialog with progress" Classes="an" Command="{Binding ProgressDialogCommand}" />
                <Button Margin="0,0,8,8" Content="Show modal" Classes="an" Command="{Binding ModalCommand}" />
            </WrapPanel>
            <TextBlock Text="Notifications" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AnMuted}" />
            <WrapPanel>
                <Button Margin="0,0,8,8" Content="Information" Classes="an" Command="{Binding InformationCommand}" />
                <Button Margin="0,0,8,8" Content="Success" Classes="an" Command="{Binding SuccessCommand}" />
                <Button Margin="0,0,8,8" Content="Warning" Classes="an" Command="{Binding WarningCommand}" />
                <Button Margin="0,0,8,8" Content="Error" Classes="an" Command="{Binding NotificationErrorCommand}" />
                <Button Margin="0,0,8,8" Content="System" Classes="an" Command="{Binding SystemNotificationCommand}" />
            </WrapPanel>

            <TextBlock Text="{Binding Result}" IsVisible="{Binding HasResult}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource AnInk}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

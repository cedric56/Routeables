<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:XAnimals.MauiHybrid"
             xmlns:animals="clr-namespace:XAnimals.Blazor.Components;assembly=XAnimals.Blazor"
             x:Class="XAnimals.MauiHybrid.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <!-- The same router, layout and style as the Blazor samples (Routes loads the images of the lists in the background too). -->
            <RootComponent Selector="#app" ComponentType="{x:Type animals:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>

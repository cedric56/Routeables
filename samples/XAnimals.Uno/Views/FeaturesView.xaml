<routeables:RouteableFor
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    xmlns:local="using:XAnimals.Uno"
    x:Class="XAnimals.Uno.Views.FeaturesView">
    <ScrollViewer>
        <StackPanel Margin="20,32,20,40" Spacing="6" MaxWidth="640">
            <TextBlock Text="Guard and return" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Text="The Members page is for members. Signed out, opening it brings you here; sign in, then open it." TextWrapping="Wrap" />
            <local:WrapPanel>
                <Button Margin="0,0,8,8" Content="Sign in" Command="{Binding SignInCommand}" IsEnabled="{Binding IsSignedOut}" />
                <Button Margin="0,0,8,8" Content="Sign out" Command="{Binding SignOutCommand}" IsEnabled="{Binding IsSignedIn}" />
                <Button Margin="0,0,8,8" Content="Open Members" Command="{Binding OpenMembersCommand}" />
            </local:WrapPanel>

            <TextBlock Text="Link" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Text="An address from outside, followed through the router. On Android, a link to xanimals:// does the same." TextWrapping="Wrap" />
            <local:WrapPanel>
                <Button Margin="0,0,8,8" Content="Open xanimals://dogs/Eurohound" Command="{Binding OpenLinkCommand}" />
            </local:WrapPanel>

            <TextBlock Visibility="{Binding IsMobile, Converter={StaticResource BoolToVisibility}}" Text="Saved values" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Visibility="{Binding IsMobile, Converter={StaticResource BoolToVisibility}}" Text="Type a note: it comes back with the page if the system closes the application." TextWrapping="Wrap" />
            <TextBox Visibility="{Binding IsMobile, Converter={StaticResource BoolToVisibility}}" Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="A note" />

            <TextBlock Text="Lock" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock Text="The page publishes a lock message; the menu entries are disabled until it publishes the unlock one." TextWrapping="Wrap" />
            <local:WrapPanel>
                <Button Margin="0,0,8,8" Content="Lock" Command="{Binding LockCommand}" IsEnabled="{Binding CanLock}" />
                <Button Margin="0,0,8,8" Content="Unlock" Command="{Binding UnlockCommand}" IsEnabled="{Binding CanUnlock}" />
                <Button Margin="0,0,8,8" Content="Lock for 5 seconds" Command="{Binding LockForCommand}" IsEnabled="{Binding CanLock}" />
            </local:WrapPanel>
            <TextBlock Text="{Binding LockStatus}" TextWrapping="Wrap" />

            <TextBlock Text="Measures" Margin="0,14,0,0" FontWeight="SemiBold" Opacity="0.7" />
            <local:WrapPanel>
                <Button Margin="0,0,8,8" Content="Show the last route changes" Command="{Binding RefreshCommand}" />
            </local:WrapPanel>
            <TextBlock Text="{Binding Measures}" TextWrapping="Wrap" />

            <TextBlock Text="{Binding Status}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</routeables:RouteableFor>

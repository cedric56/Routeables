<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:routeables="using:Routeables.Uno"
    x:Class="XAnimals.Uno.MainPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre d'en-tête : titre + bouton de bascule -->
        <Grid Grid.Row="0" Margin="20,12" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
            <Button x:Name="PaneToggleButton"
                    Content="☰"
                    Click="PaneToggleButton_Click"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2"
                    Content="&#x25D0;"
                    Click="ThemeToggleButton_Click"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Switch between the light and the dark theme"/>
        </Grid>

        <!-- SplitView : nécessite x:Name pour être référencé dans le code-behind -->
        <SplitView Grid.Row="1"
                   x:Name="RootSplitView"
                   IsPaneOpen="True">
            <SplitView.Pane>
                <routeables:RouteableListView />
            </SplitView.Pane>

            <ContentControl Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </SplitView>
    </Grid>
</Page>